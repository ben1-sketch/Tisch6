# Supabase (Project Settings → API Keys) – setzt die Supabase-Vercel-Integration automatisch
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Publishable key (sb_publishable_…); der ältere "anon"-Key geht auch als NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nur serverseitig – niemals im Browser verwenden. Secret key (sb_secret_…);
# der ältere "service_role"-Key geht auch als SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=

# Claude API (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Optional: Modell überschreiben (Standard: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Öffentliche Adresse der Website
NEXT_PUBLIC_SITE_URL=https://tisch6.at

# Verschlüsselung der Verifizierungsfotos: beliebige lange Passphrase (mind. 32 Zeichen).
# Gut aufbewahren – geht sie verloren, sind die Fotos nicht mehr lesbar.
PHOTO_ENCRYPTION_KEY=
