# Supabase (Project Settings → API Keys) – setzt die Supabase-Vercel-Integration automatisch
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Publishable key (sb_publishable_…); der ältere "anon"-Key geht auch als NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nur serverseitig – niemals im Browser verwenden. Secret key (sb_secret_…);
# der ältere "service_role"-Key geht auch als SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=

# Claude API (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Optional: Modell überschreiben (Standard: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Öffentliche Adresse der Website
NEXT_PUBLIC_SITE_URL=https://tisch6.at

# Verschlüsselung der Verifizierungsfotos: beliebige lange Passphrase (mind. 32 Zeichen).
# Gut aufbewahren – geht sie verloren, sind die Fotos nicht mehr lesbar.
PHOTO_ENCRYPTION_KEY=

# --- Etappe 2 ---
# E-Mails (resend.com)
RESEND_API_KEY=
EMAIL_FROM=Tisch6 <hallo@tisch6.at>
EMAIL_REPLY_TO=
# Hinweise ans Team: Meldungen, verschobene Dinner, Reservierungen ohne Lokal-E-Mail
ADMIN_EMAIL=

# Zahlungen (stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMS für Erinnerungen und Nachrücker (twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Schützt den automatischen Durchlauf /api/cron/tick (dasselbe Geheimnis im Supabase-Zeitplan)
CRON_SECRET=

# --- Etappe 3 ---
# Passwort für den Adminbereich /admin (mindestens 12 Zeichen). Ändern meldet alle Sitzungen ab.
ADMIN_PASSWORD=
